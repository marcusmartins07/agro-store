# Django (desenvolvimento)
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# vazio no desenvolvimento para usar o proxy do Vite.
VITE_API_URL=/api/v1
VITE_BACKEND_URL=

# Banco: vazio usa SQLite. Para o Supabase, use a string do "Session pooler":
# postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_SSLMODE=require
# Segundos que uma conexão fica aberta para reuso. Mantenha 0 com o runserver.
DATABASE_CONN_MAX_AGE=0

# Imagens: vazio salva em apps/backend/media. Para o Supabase Storage, crie um bucket
# público e gere as chaves S3 em Project Settings > Storage.
SUPABASE_STORAGE_BUCKET=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
