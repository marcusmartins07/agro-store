%% Figura 2 - Modelo Lógico do Banco de Dados (Agro Store)
%% Fonte da verdade: docs/modelo-logico.sql, versão 2.4 (modelo-alvo PostgreSQL): 18 tabelas, colunas, chaves e cardinalidades conforme o DDL.
%% O schema implementado (models e migrations do Django) diverge em on_delete, CHECK/UNIQUE, nomes de constraint e nulidade; as divergências estão no cabeçalho do modelo-logico.sql e na seção 3.2.4 do TCC.
erDiagram
    genero ||--o{ usuario : classifica
    usuario ||--o{ redefinicao_senha : solicita
    usuario ||--o{ telefone : possui
    tipo_telefone ||--o{ telefone : classifica
    usuario ||--o| loja : "é proprietário de"
    loja ||--o{ produto : oferece
    categoria ||--o{ produto : classifica
    produto ||--o{ preco_produto : "tem histórico de"
    produto ||--o{ imagem : possui
    usuario ||--o{ carrinho : possui
    loja ||--o{ carrinho : agrupa
    carrinho ||--o{ carrinho_produto : contem
    produto ||--o{ carrinho_produto : "está em"
    loja ||--o{ pedido : recebe
    status_pedido ||--o{ pedido : define
    pedido ||--o| pedido_cliente : "preserva o cliente em"
    usuario ||--o{ pedido_cliente : realiza
    pedido ||--o{ pedido_produto : contem
    produto |o--o{ pedido_produto : "vendido em"
    usuario ||--o{ favorito : marca
    produto ||--o{ favorito : "favoritado em"
    usuario ||--o{ avaliacao : escreve
    produto |o--o{ avaliacao : recebe
    pedido_produto ||--o| avaliacao : "avaliado por"

    genero {
        varchar(2) codigo_genero PK
        varchar(55) nome UK
    }

    usuario {
        bigint id_usuario PK
        varchar(150) nome
        varchar(11) cpf UK
        varchar(254) email UK
        date data_nascimento
        varchar(255) foto_perfil "vazio quando sem foto"
        varchar(128) senha
        timestamptz ultimo_login "opcional"
        boolean e_produtor
        boolean esta_ativo
        boolean e_equipe
        boolean e_superusuario
        varchar(2) codigo_genero FK "RESTRICT"
    }

    redefinicao_senha {
        bigint id_redefinicao PK
        bigint id_usuario FK "CASCADE"
        varchar(64) token_hash UK
        timestamptz data_expiracao "CHECK maior que data_criacao"
        timestamptz data_utilizacao "opcional"
        timestamptz data_criacao
    }

    tipo_telefone {
        bigint id_tipo_telefone PK
        varchar(30) descricao UK
    }

    telefone {
        bigint id_telefone PK
        bigint id_usuario FK "CASCADE"
        bigint id_tipo_telefone FK "RESTRICT"
        varchar(11) numero
        boolean e_principal "único por usuário quando verdadeiro"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    loja {
        bigint id_loja PK
        bigint id_proprietario FK, UK "RESTRICT, uq_loja_proprietario"
        varchar(150) nome
        text descricao
        varchar(14) cnpj UK
        varchar(255) imagem_perfil "vazio quando sem imagem"
        boolean esta_ativa
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    categoria {
        bigint id_categoria PK
        varchar(100) nome UK
        boolean esta_ativa
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    produto {
        bigint id_produto PK
        bigint id_loja FK "RESTRICT"
        bigint id_categoria FK "RESTRICT"
        varchar(155) nome
        text descricao
        varchar(13) codigo_barras "opcional"
        integer estoque "CHECK maior ou igual a 0"
        varchar(50) sku UK
        boolean esta_ativo
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    preco_produto {
        bigint id_preco_produto PK
        bigint id_produto FK "RESTRICT"
        decimal valor_venda "10,2; CHECK maior ou igual a 0"
        decimal valor_custo "10,2; opcional; CHECK maior ou igual a 0"
        decimal valor_desconto "10,2; opcional; CHECK maior ou igual a 0"
        integer porcentagem_desconto "opcional; CHECK entre 0 e 100"
        timestamptz vigencia_inicio
        timestamptz vigencia_fim "opcional; ck_preco_vigencia"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    imagem {
        bigint id_imagem PK
        bigint id_produto FK, UK "CASCADE; uq_imagem_produto_ordem (id_produto, ordem)"
        varchar(255) caminho
        integer ordem UK "CHECK maior ou igual a 0"
        boolean e_principal "única por produto quando verdadeiro"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    carrinho {
        bigint id_carrinho PK
        bigint id_usuario FK, UK "CASCADE; uq_carrinho_usuario_loja (id_usuario, id_loja)"
        bigint id_loja FK, UK "CASCADE"
        decimal valor_bruto "10,2; CHECK maior ou igual a 0"
        decimal valor_desconto "10,2; CHECK maior ou igual a 0"
        decimal valor_liquido "10,2; CHECK maior ou igual a 0"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    carrinho_produto {
        bigint id_carrinho_produto PK
        bigint id_carrinho FK, UK "CASCADE; uq_carrinho_produto (id_carrinho, id_produto)"
        bigint id_produto FK, UK "CASCADE"
        integer quantidade "CHECK maior ou igual a 0"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    status_pedido {
        bigint id_status_pedido PK
        varchar(55) nome UK
    }

    pedido {
        bigint id_pedido PK
        bigint id_loja FK "RESTRICT"
        bigint id_status_pedido FK "RESTRICT"
        decimal valor_bruto "10,2; CHECK maior ou igual a 0"
        decimal valor_desconto "10,2; CHECK maior ou igual a 0"
        decimal valor_liquido "10,2; CHECK maior ou igual a 0"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    pedido_cliente {
        bigint id_pedido_cliente PK
        bigint id_pedido FK, UK "CASCADE"
        bigint id_usuario FK "RESTRICT"
        varchar(150) nome
        varchar(11) cpf
        varchar(254) email
        date data_nascimento
        varchar(55) genero
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    pedido_produto {
        bigint id_pedido_produto PK
        bigint id_pedido FK "CASCADE"
        bigint id_produto FK "opcional; SET NULL"
        varchar(155) nome_produto
        integer quantidade "CHECK maior que 0"
        decimal valor_unitario "10,2; CHECK maior ou igual a 0"
        decimal valor_desconto "10,2; CHECK maior ou igual a 0"
        decimal subtotal "10,2; CHECK maior ou igual a 0"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    favorito {
        bigint id_favorito PK
        bigint id_usuario FK, UK "CASCADE; uq_favorito_usuario_produto (id_usuario, id_produto)"
        bigint id_produto FK, UK "CASCADE"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }

    avaliacao {
        bigint id_avaliacao PK
        bigint id_usuario FK "RESTRICT"
        bigint id_produto FK "opcional; SET NULL"
        bigint id_pedido_produto FK, UK "RESTRICT"
        integer nota "CHECK entre 1 e 5"
        text comentario "ck_avaliacao_comentario_tamanho: até 500"
        timestamptz data_criacao
        timestamptz data_atualizacao
    }
